:root { --brand: {{ c.primary_color }}; --ink: #1f2933; --muted: #52606d; --bg: #f7f9fb; }
* { box-sizing: border-box; }
body { margin: 0; font-family: system-ui, "Segoe UI", sans-serif; color: var(--ink); background: var(--bg); line-height: 1.6; }
.hero { background: var(--brand); color: #fff; padding: 2rem clamp(1rem, 5vw, 4rem) 4rem; }
.hero nav { margin-bottom: 3rem; font-size: 1.2rem; }
.hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.1; max-width: 18ch; margin: 0 0 1rem; }
.hero p { max-width: 55ch; font-size: 1.1rem; opacity: 0.92; }
.button, button { display: inline-block; background: #fff; color: var(--brand); padding: 0.8rem 1.4rem; border-radius: 8px; font-weight: 700; text-decoration: none; border: 0; cursor: pointer; font-size: 1rem; }
main { max-width: 1000px; margin: 0 auto; padding: 0 1rem; }
section { padding: 3rem 0; }
.grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
.grid article { background: #fff; border: 1px solid #e4e7eb; border-radius: 10px; padding: 1.25rem; }
.grid h3 { margin-top: 0; color: var(--brand); }
.signup form { display: flex; gap: 0.5rem; flex-wrap: wrap; }
.signup input { flex: 1; min-width: 220px; padding: 0.8rem; border: 1px solid #cbd2d9; border-radius: 8px; font-size: 1rem; }
.signup button { background: var(--brand); color: #fff; }
footer { text-align: center; color: var(--muted); padding: 2rem; }
