<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ c.app_name }}</title>
  <style>
    :root { --brand: {{ c.primary_color }}; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, "Segoe UI", sans-serif; background: #f5f7fa; color: #1f2933; }
    header { background: var(--brand); color: #fff; padding: 1.5rem; }
    header h1 { margin: 0; }
    header p { margin: 0.25rem 0 0; opacity: 0.9; }
    main { max-width: 760px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
    form, .item { background: #fff; border: 1px solid #e4e7eb; border-radius: 10px; padding: 1rem; }
    form { display: grid; gap: 0.6rem; margin-bottom: 1.5rem; }
    input, textarea, select { font: inherit; padding: 0.6rem; border: 1px solid #cbd2d9; border-radius: 6px; width: 100%; }
    button { font: inherit; font-weight: 600; background: var(--brand); color: #fff; border: 0; border-radius: 6px; padding: 0.7rem; cursor: pointer; }
    .list { display: grid; gap: 0.75rem; }
    .item { display: flex; justify-content: space-between; gap: 1rem; }
    .item h3 { margin: 0 0 0.25rem; }
    .item p { margin: 0; color: #52606d; }
    .stars { color: var(--brand); }
    .delete { background: transparent; color: #b42318; border: 1px solid #e4e7eb; padding: 0.3rem 0.6rem; height: fit-content; }
    .empty { color: #52606d; text-align: center; }
  </style>
</head>
<body>
  <header>
    <h1>{{ c.app_name }}</h1>
    <p>{{ c.tagline }}</p>
  </header>
  <main>
    <form id="form">
      <strong>Add a {{ c.entity_name }}</strong>
      <input id="title" placeholder="Title" required maxlength="120" />
      <textarea id="details" placeholder="Details (optional)" rows="3" maxlength="1000"></textarea>
      <select id="score" aria-label="Score">
        <option value="">No score</option>
        <option value="5">5 - Excellent</option>
        <option value="4">4 - Good</option>
        <option value="3">3 - Okay</option>
        <option value="2">2 - Poor</option>
        <option value="1">1 - Bad</option>
      </select>
      <button type="submit">Save {{ c.entity_name }}</button>
    </form>
    <div id="list" class="list"></div>
  </main>

  <script>
    const ENTITY_PLURAL = {{ c.entity_plural | tojson }};
    const list = document.getElementById("list");

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch]);
    }

    async function load() {
      const items = await (await fetch("/api/items")).json();
      if (!items.length) {
        list.innerHTML = `<p class="empty">No ${ENTITY_PLURAL} yet. Add the first one above.</p>`;
        return;
      }
      list.innerHTML = items.map((it) => `
        <div class="item">
          <div>
            <h3>${escapeHtml(it.title)} ${it.score ? `<span class="stars">${"★".repeat(it.score)}</span>` : ""}</h3>
            <p>${escapeHtml(it.details)}</p>
          </div>
          <button class="delete" onclick="removeItem(${it.id})">Delete</button>
        </div>`).join("");
    }

    async function removeItem(id) {
      await fetch(`/api/items/${id}`, { method: "DELETE" });
      load();
    }

    document.getElementById("form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const score = document.getElementById("score").value;
      await fetch("/api/items", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          title: document.getElementById("title").value,
          details: document.getElementById("details").value,
          score: score ? Number(score) : null,
        }),
      });
      e.target.reset();
      load();
    });

    load();
  </script>
</body>
</html>
